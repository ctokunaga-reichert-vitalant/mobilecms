@model List<Mobile_CMS.Models.MFAModel>

@{
    ViewData["Title"] = "Mobile App Multi-Factor Authentication";
}

<div>
    <div>
        <h3>Multi-Factor Authentication</h3> @*Looking to display the count of the data displayed*@
        <div>
            <select id="lastInitial"></select>
        </div>
        <div>
            <label>Donor ID:</label>
            <input type="text" id="searchDonorId" />
            <label>Email:</label>
            <input type="text" id="searchEmail" />
            <label>Last Name:</label>
            <input type="text" id="searchLastName" />
            <label>First Name:</label>
            <input type="text" id="searchFirstName" />
        </div>
        <div>
            <button onclick="SearchUsers()">Search</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Donor ID</th>
                    <th>Phone</th>
                    <th>MFA Enabled</th>
                </tr>
            </thead>
            <tbody id="mfaStatusBody"></tbody>
        </table>
    </div>
</div>
