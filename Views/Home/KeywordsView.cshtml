@model List<Mobile_CMS.Models.KeywordsModel>

@{
    ViewData["Title"] = "Mobile App Marketing Keywords";
}

<div>
    <div>
        <h3>Keywords</h3> @*Looking to display the count of the data displayed*@
        <div>
            <select id="keywordsSection"></select>
        </div>
        <div>
            <button onclick="NewKeyword()">New Keyword</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Actions</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Section</th>
                </tr>
            </thead>
            <tbody id="keywordsBody"></tbody>
        </table>
    </div>
</div>
