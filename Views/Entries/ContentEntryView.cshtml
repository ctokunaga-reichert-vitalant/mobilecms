@model Mobile_CMS.Models.ContentModel

@{
    ViewData["Title"] = "Mobile App Marketing Content Entry";
}

<div>
    <h2>Content</h2>
    <div>
        <div>
            <label>Title</label>
            <input type="text" id="contentTitle" />
        </div>
        <div>
            <label>Publish From</label>
            <input type="date" id="contentPublishFrom" />
            <label>Publish To</label>
            <input type="date" id="contentPublishTo" />
        </div>
        <div>
            <label>Description</label>
            <textarea rows="5" id="contentDescription" />
        </div>
        <div>
            <input type="checkbox" id="contentActive" />
            <label for="contentActive">Active</label>
        </div>
        <div>
            <input type="checkbox" id="contentConditions" />
            <label for="contentConditions">Conditions</label>
        </div>
        <h3>Filter by Donation Details</h3>
        <div>
            <label>Blood Type</label>
            <select id="contentBloodType" multiple>
                <option value="0">A+</option>
                <option value="1">A-</option>
                <option value="2">B+</option>
                <option value="3">B-</option>
                <option value="4">AB+</option>
                <option value="5">AB-</option>
                <option value="6">O+</option>
                <option value="7">O-</option>
            </select>
        </div>
        <div>
            <label>Donation Type</label>
            <select id="contentDonationType" multiple>
                <option value="0">Whole Blood</option>
                <option value="1">Power Red</option>
                <option value="2">Platelet</option>
                <option value="3">Plasma</option>
                <option value="4">Source Plasma</option>
            </select>
        </div>
        <div>
            <label>Donor Status</label>
            <select id="contentDonorStatus" multiple>
                <option value="0">Active</option>
                <option value="1">Inactive</option>
                <option value="2">Prospect</option>
                <option value="3">Lapsed</option>
                <option value="4">Super Lapsed</option>
            </select>
        </div>
        <h3>Filter By Donation Timeline</h3>
        <div>
            <fieldset>
                <div>
                    <input type="radio" id="contentBeforeDate" name="donationDate" value="0" />
                    <label for="contentBeforeDate">Before</label>
                </div>
                <div>
                    <input type="radio" id="contentBetweenDate" name="donationDate" value="1" />
                    <label for="contentBetweenDate">Between</label>
                </div>
                <div>
                    <input type="radio" id="contentAfterDate" name="donationDate" value="2" />
                    <label for="contentAfterDate">After</label>
                </div>
            </fieldset>
            <div>
                <input type="date" id="contentDate1" />
                <label id="lblDate1" for="contentDate1" />
            </div>
            <div>
                <input type="date" id="contentDate2" />
                <label id="lblDate2" for="contentDate2" />
            </div>
        </div>
        <h3>Filter by Location</h3>
        <div>
            <label>State</label>
            <select id="contentStates" multiple />
        </div>
        <div>
            <label>Zip Code</label>
            <input id="contentZipCodes" type="text" />
        </div>
        <div>
            <button onclick="SubmitContent()" id="btnSubmitContent" />
            <button onclick="CancelContent()">Cancel</button>
        </div>
    </div>
</div>