@model Mobile_CMS.Models.ScreenshotsModel

@{
    ViewData["Title"] = "Mobile App Marketing Screenshot Entry";
}

<div>
    <h2>Screenshot</h2>
    <div>
        <h3>Details</h3>
        <div>
            <div>
                <label>Title</label>
                <input id="screenshotTitle" type="text" />
            </div>
            <div>
                <label>Section</label>
                <select id="screenshotSection" />
            </div>
            <div>
                <label>Keyword</label>
                <select id="screenshotKeyword" />
            </div>
            <input type="checkbox" id="screenshotActive" />
            <label for="screenshotActive">Active</label>
        </div>
    </div>
    <div>
        <h3>Screenshot</h3>
        <div>
            <div>
                <label id="lblScreenshotStatus" />
                <img id="imgScreenshotPic" />
                <button onclick="RemoveScreenshot()">Remove</button>
            </div>
            <div>
                <form action="#" method="post" enctype="multipart/form-data">
                    <label for="screenshotFile">Choose File:</label>
                    <input type="file" id="screenshotFile" name="uploadedFile" accept=".jpg, .png" />
                    <input type="submit" value="submit" id="submit" />
                </form>
            </div>
        </div>
    </div>
    <div>
        <button onclick="SubmitScreenshot()" id="btnSubmitScreenshot" />
        <button onclick="CancelScreenshot()">Cancel</button>
    </div>
</div>
